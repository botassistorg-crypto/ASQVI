{
  "entities": {
    "Product": {
      "title": "Product",
      "description": "A digital product available for sale.",
      "type": "object",
      "properties": {
        "title": { "type": "string" },
        "description": { "type": "string" },
        "price": { "type": "number" },
        "imageUrl": { "type": "string" },
        "category": { "type": "string" },
        "perks": { "type": "array", "items": { "type": "string" } },
        "contentLink": { "type": "string", "description": "Link to the digital content provided after purchase." },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["title", "description", "price", "imageUrl", "category"]
    },
    "Category": {
      "title": "Category",
      "description": "Product category.",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "slug": { "type": "string" },
        "icon": { "type": "string" }
      },
      "required": ["name", "slug"]
    },
    "Order": {
      "title": "Order",
      "description": "Customer purchase order.",
      "type": "object",
      "properties": {
        "customerName": { "type": "string" },
        "customerEmail": { "type": "string" },
        "customerWhatsapp": { "type": "string" },
        "senderNumber": { "type": "string" },
        "productId": { "type": "string" },
        "productTitle": { "type": "string" },
        "amount": { "type": "number" },
        "status": { "type": "string", "enum": ["pending", "completed", "rejected"] },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["customerName", "customerWhatsapp", "senderNumber", "productId", "amount", "status"]
    },
    "SiteSettings": {
      "title": "SiteSettings",
      "description": "Global website configuration.",
      "type": "object",
      "properties": {
        "bKashNumber": { "type": "string" },
        "siteName": { "type": "string" },
        "heroTitle": { "type": "string" },
        "heroSubtitle": { "type": "string" },
        "checkoutRules": { "type": "string" },
        "announcement": { "type": "string" }
      }
    }
  },
  "firestore": {
    "/products/{productId}": { "schema": "Product", "description": "Collection of products." },
    "/categories/{categoryId}": { "schema": "Category", "description": "Collection of product categories." },
    "/orders/{orderId}": { "schema": "Order", "description": "Collection of customer orders." },
    "/settings/general": { "schema": "SiteSettings", "description": "Global site settings." }
  }
}
